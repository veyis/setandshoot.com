{
  "name": "belinakguel-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "format": "prettier --write .",
    "payload": "bash scripts/payload-cli.sh",
    "payload:migrate": "bash scripts/payload-cli.sh migrate",
    "payload:migrate:status": "bash scripts/payload-cli.sh migrate:status",
    "payload:migrate:force": "PAYLOAD_MIGRATE_FORCE=1 bash scripts/payload-cli.sh migrate",
    "payload:migrate:mark": "bash scripts/payload-mark-migration-applied.sh",
    "payload:generate-types": "bash scripts/payload-cli.sh generate:types",
    "payload:reset-password": "bash scripts/payload-cli.sh run scripts/reset-payload-password.ts",
    "neon:reset-password": "bash scripts/payload-cli.sh run scripts/reset-neon-auth-password.ts",
    "seed:photos": "tsx --env-file=.env.local scripts/seed/photos.ts",
    "seed:about-page": "bash scripts/payload-cli.sh run scripts/seed/about-page.ts",
    "seed:marketing-pages": "bash scripts/payload-cli.sh run scripts/seed/marketing-pages.ts"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@lexical/headless": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@neondatabase/auth": "0.4.2-beta",
    "@neondatabase/auth-ui": "0.2.1-beta",
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/email-resend": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/storage-s3": "3.87.1",
    "@sentry/nextjs": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lexical": "0.49.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "payload": "3.87.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/config": "^0.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
