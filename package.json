{
  "name": "belinakguel-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "format": "prettier --write .",
    "payload": "bash scripts/payload-cli.sh",
    "payload:migrate": "bash scripts/payload-cli.sh migrate",
    "payload:migrate:status": "bash scripts/payload-cli.sh migrate:status",
    "payload:migrate:force": "PAYLOAD_MIGRATE_FORCE=1 bash scripts/payload-cli.sh migrate",
    "payload:migrate:mark": "bash scripts/payload-mark-migration-applied.sh",
    "payload:generate-types": "bash scripts/payload-cli.sh generate:types",
    "payload:reset-password": "bash scripts/payload-cli.sh run scripts/reset-payload-password.ts",
    "neon:reset-password": "bash scripts/payload-cli.sh run scripts/reset-neon-auth-password.ts",
    "seed:photos": "tsx --env-file=.env.local scripts/seed/photos.ts",
    "seed:about-page": "bash scripts/payload-cli.sh run scripts/seed/about-page.ts",
    "seed:marketing-pages": "bash scripts/payload-cli.sh run scripts/seed/marketing-pages.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@lexical/headless": "0.51.0",
    "@lexical/link": "0.51.0",
    "@lexical/react": "0.51.0",
    "@lexical/utils": "0.51.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/auth-ui": "0.3.0-beta",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-resend": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@sentry/nextjs": "^10.74.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lexical": "0.51.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.6",
    "payload": "3.90.2",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/config": "^0.7.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "typescript-v6": "npm:typescript@6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
