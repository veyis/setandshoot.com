{
  "name": "belinakguel-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "format": "prettier --write .",
    "payload": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload",
    "payload:generate-types": "PAYLOAD_CONFIG_PATH=src/payload/payload.config.ts payload generate:types",
    "supabase": "supabase",
    "supabase:db-push": "bash scripts/supabase-db-push.sh",
    "supabase:db-push:hetzner": "bash scripts/supabase-apply-hetzner.sh",
    "supabase:vercel-env": "bash scripts/sync-vercel-supabase-env.sh",
    "mcp:tunnel": "bash scripts/supabase-mcp-tunnel.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.0.0",
    "next-intl": "^4.12.0",
    "payload": "^3.84.1",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/config": "^0.5.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "lefthook": "^1.9.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "supabase": "^2.98.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
