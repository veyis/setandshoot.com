{
  "name": "belinakguel-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "format": "prettier --write .",
    "payload": "bash scripts/payload-cli.sh",
    "payload:migrate": "bash scripts/payload-cli.sh migrate",
    "payload:migrate:status": "bash scripts/payload-cli.sh migrate:status",
    "payload:migrate:force": "PAYLOAD_MIGRATE_FORCE=1 bash scripts/payload-cli.sh migrate",
    "payload:migrate:mark": "bash scripts/payload-mark-migration-applied.sh",
    "payload:generate-types": "bash scripts/payload-cli.sh generate:types",
    "payload:reset-password": "bash scripts/payload-cli.sh run scripts/reset-payload-password.ts",
    "neon:reset-password": "bash scripts/payload-cli.sh run scripts/reset-neon-auth-password.ts",
    "seed:photos": "tsx --env-file=.env.local scripts/seed/photos.ts",
    "seed:about-page": "bash scripts/payload-cli.sh run scripts/seed/about-page.ts",
    "seed:marketing-pages": "bash scripts/payload-cli.sh run scripts/seed/marketing-pages.ts"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@neondatabase/auth": "0.4.1-beta",
    "@neondatabase/auth-ui": "0.2.0-beta",
    "@payloadcms/db-postgres": "3.84.1",
    "@payloadcms/email-resend": "3.84.1",
    "@payloadcms/next": "3.84.1",
    "@payloadcms/richtext-lexical": "3.84.1",
    "@payloadcms/storage-s3": "3.84.1",
    "@sentry/nextjs": "^10.53.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "next": "^16.0.0",
    "next-intl": "^4.12.0",
    "payload": "3.84.1",
    "postcss": "^8.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/config": "^0.5.0",
    "@vitest/coverage-v8": "^4.1.6",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^29.1.1",
    "lefthook": "^1.9.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tsx": "^4.22.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
