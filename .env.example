# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Self-hosted Supabase (Hetzner) — https://api.setandshoot.com
NEXT_PUBLIC_SUPABASE_URL=https://api.setandshoot.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel / API routes — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres (Payload CMS, migrations)
# Password: on server run `grep '^POSTGRES_PASSWORD=' /opt/supabase/docker/.env`
#
# Local dev (SSH tunnel — keep tunnel open):
#   ssh -N -L 54322:127.0.0.1:5432 root@5.78.213.173
#   DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:54322/postgres
#
# Vercel / remote (only if Supavisor or Postgres is exposed on the host):
#   DATABASE_URL=postgresql://postgres:PASSWORD@api.setandshoot.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@api.setandshoot.com:5432/postgres?sslmode=require

# Payload
PAYLOAD_SECRET=replace-me-with-32-or-more-random-chars

# Vercel Blob (optional)
BLOB_READ_WRITE_TOKEN=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN= 