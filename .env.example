# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production URL (used by scripts/sync-vercel-supabase-env.sh)
NEXT_PUBLIC_SITE_URL_PRODUCTION=https://www.setandshoot.com

# Self-hosted Supabase (Hetzner) — https://api.setandshoot.com
NEXT_PUBLIC_SUPABASE_URL=https://api.setandshoot.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel / API routes — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres (Payload CMS) — Supavisor session mode
# POOLER_TENANT_ID from: grep '^POOLER_TENANT_ID=' /opt/supabase/docker/.env
#   postgresql://postgres.your-tenant-id:PASSWORD@api.setandshoot.com:5432/postgres?sslmode=disable
DATABASE_URL=postgresql://postgres.your-tenant-id:PASSWORD@api.setandshoot.com:5432/postgres?sslmode=disable

# Payload
PAYLOAD_SECRET=replace-me-with-32-or-more-random-chars

# Supabase S3 storage (optional — enable in payload.config.ts)
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1

# Vercel Blob (optional)
BLOB_READ_WRITE_TOKEN=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
