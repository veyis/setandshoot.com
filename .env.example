# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL_PRODUCTION=https://setandshoot.com

# Neon Postgres (Payload CMS + Bookings) — pooled connection recommended
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# Payload
PAYLOAD_SECRET=replace-me-with-32-or-more-random-chars

# Cloudflare R2 (media storage — S3-compatible). Leave blank to use local disk.
# Create a bucket + an S3 API token (Object Read & Write) in the Cloudflare R2 dashboard.
R2_BUCKET=setandshoot-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public base URL for serving images (R2 custom domain bound to the bucket).
R2_PUBLIC_BASE_URL=https://cdn.setandshoot.com

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-yellow-sea-a2m6oq9a.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-me-with-openssl-rand-base64-32
# Comma-separated emails auto-promoted to Neon Auth role=admin (proxy /admin gate)
ADMIN_EMAILS=you@example.com

# Email (Payload CMS — Resend)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@setandshoot.com
EMAIL_FROM_NAME=Set and Shoot

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
