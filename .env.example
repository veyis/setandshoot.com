# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL_PRODUCTION=https://www.setandshoot.com

# Neon Postgres (Payload CMS) — pooled connection recommended
# https://neon.tech/docs/connect/connect-from-any-app
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Payload
PAYLOAD_SECRET=replace-me-with-32-or-more-random-chars

# Supabase (booking API — optional if you use hosted/self-hosted Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Photo storage (optional — S3-compatible or Vercel Blob)
SUPABASE_S3_BUCKET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1
BLOB_READ_WRITE_TOKEN=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
